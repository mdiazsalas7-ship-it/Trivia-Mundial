rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Territorios de Conquista Mundial
    match /cq_terr/{territorio} {
      // El mapa es público: cualquiera ve quién domina qué.
      allow read: if true;

      // Solo se aceptan documentos ligeros y con la forma esperada.
      // No se guardan imágenes ni datos personales.
      allow create, update: if request.resource.data.keys().hasOnly(['cod','jn','jb','jc','g','ts'])
        && request.resource.data.cod is string
        && request.resource.data.cod.size() <= 8
        && request.resource.data.jn is string
        && request.resource.data.jn.size() >= 1
        && request.resource.data.jn.size() <= 16
        && request.resource.data.g is number
        && request.resource.data.g >= 0
        && request.resource.data.g <= 130
        && request.resource.data.ts is number;

      allow delete: if false;
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
